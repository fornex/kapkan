{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generated from engine/internal/config/zones.go by `make -C engine schema`. DO NOT EDIT BY HAND. The zones file the brain serves to edge nodes (edge.zones_file): one entry per zone with its origins, TLS floor, ACME directories and per-request policy. The file shape is closed: unknown keys are rejected. Names are lower-case hostnames (no wildcards, no IPs, at most 238 characters), origins are host:port with a bracketed IPv6 host; both are checked imperatively, not by pattern.",
  "properties": {
    "zones": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "acme": {
            "additionalProperties": false,
            "properties": {
              "directory": {
                "type": "string"
              },
              "fallback": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "extra_directives_file": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "origins": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "x-optional": true
          },
          "policy": {
            "additionalProperties": false,
            "properties": {
              "challenge": {
                "enum": [
                  "off",
                  "manual",
                  "auto"
                ],
                "type": "string"
              },
              "challenge_options": {
                "additionalProperties": false,
                "properties": {
                  "dry_run": {
                    "type": "boolean",
                    "x-optional": true
                  },
                  "exempt_paths": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array",
                    "x-optional": true
                  }
                },
                "type": "object"
              },
              "failure_mode": {
                "enum": [
                  "open",
                  "closed"
                ],
                "type": "string"
              },
              "mode": {
                "enum": [
                  "decide",
                  "none"
                ],
                "type": "string"
              },
              "rate": {
                "additionalProperties": false,
                "properties": {
                  "concurrency": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "rps": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "tls": {
            "additionalProperties": false,
            "properties": {
              "h3": {
                "type": "boolean"
              },
              "min_version": {
                "enum": [
                  "1.2",
                  "1.3"
                ],
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "type": "array",
      "x-optional": true
    }
  },
  "title": "Kapkan edge zones",
  "type": "object"
}
