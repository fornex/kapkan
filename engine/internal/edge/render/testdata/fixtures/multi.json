{
  "doc": {
    "version": 1,
    "zones": [
      {
        "name": "b.example.com",
        "origins": ["10.0.1.1:8080", "10.0.1.2:8080", "10.0.1.3:8080"],
        "tls": {"min_version": "1.2"},
        "policy": {"mode": "decide", "failure_mode": "open", "challenge": "off", "rate": {"rps": 50}}
      },
      {
        "name": "a.example.com",
        "origins": ["10.0.2.1:80"],
        "tls": {"min_version": "1.3"},
        "policy": {"mode": "none", "failure_mode": "closed", "challenge": "off", "rate": {"concurrency": 10}}
      },
      {
        "name": "c.example.com",
        "origins": ["10.0.3.1:443"],
        "tls": {"min_version": "1.2"},
        "policy": {"mode": "decide", "failure_mode": "closed", "challenge": "off", "rate": {}}
      }
    ],
    "acme_challenges": [],
    "issuance_grants": []
  },
  "certs": {
    "a.example.com": {
      "fullchain": "/var/lib/kapkan/edge/certs/a.example.com/fullchain.pem",
      "key": "/var/lib/kapkan/edge/certs/a.example.com/privkey.pem"
    },
    "b.example.com": {
      "fullchain": "/var/lib/kapkan/edge/certs/b.example.com/fullchain.pem",
      "key": "/var/lib/kapkan/edge/certs/b.example.com/privkey.pem"
    }
  },
  "node": {
    "decide_socket": "/run/kapkan-test/decide.sock",
    "challenge_socket": "/run/kapkan-test/challenge.sock",
    "log_socket": "/run/kapkan-test/log.sock",
    "empty_root": "/srv/kapkan-empty",
    "disable_ipv6": true
  }
}
