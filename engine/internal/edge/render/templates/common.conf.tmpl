# Generated by kapkan edge — DO NOT EDIT.
#
# Every file in this directory is rewritten on each zones change and swapped in
# as a whole generation behind `nginx -t` (edge-spec §2.4). Hand edits are lost
# on the next render; per-zone additions belong in that zone's
# extra_directives_file (edge-spec §4).
#
# The operator's nginx.conf includes this directory once, inside http{}:
#     include /var/lib/kapkan-edge/conf/live/*.conf;
# nginx includes a glob in name order; the 00_ prefix keeps these shared
# definitions ahead of the per-zone files that reference them.

# One JSON object per request, shipped to kapkan over a unix datagram socket
# (internal/edge/rollup parses it). escape=json makes every $variable safe
# inside its quotes. "port" tells :80 traffic from decided :443 traffic;
# "decision" is the decision service's answer for this request (200/403/401,
# a 5xx when it could not be reached, empty when the zone does not decide),
# "reason" why it denied or challenged (rate, concurrency, table:<reason>,
# challenge:<why>) and "mark" what it marked — in watch-only mode a denial is
# a 200 marked would-deny:<reason>, a challenge one marked
# would-challenge:<why>; a request that cleared the rung is marked cleared.
log_format kapkan_edge escape=json '{'
    '"ts":"$time_iso8601",'
    '"zone":"$server_name",'
    '"src":"$remote_addr",'
    '"port":$server_port,'
    '"method":"$request_method",'
    '"host":"$host",'
    '"uri":"$request_uri",'
    '"status":$status,'
    '"bytes":$body_bytes_sent,'
    '"rt":$request_time,'
    '"urt":"$upstream_response_time",'
    '"ua":"$http_user_agent",'
    '"decision":"$kapkan_decision",'
    '"reason":"$kapkan_reason",'
    '"mark":"$kapkan_mark"'
'}';

# The decision variables are declared here (empty) so every server may log
# them; a decide-mode zone overwrites them per request from the subrequest.
map $upstream_status $kapkan_decision {
    default "";
}
map $upstream_status $kapkan_reason {
    default "";
}
map $upstream_status $kapkan_mark {
    default "";
}

# The decision service (edge-spec §5): HTTP/1.1 over a unix socket, kept alive
# because it is consulted once per request at attack rates.
upstream kapkan_decide {
    server unix:{{.Node.DecideSocket}};
    keepalive 64;
}

# The ACME HTTP-01 answerer (edge-spec §3): every node serves the brain-fanned
# challenge table, so a CA may validate against any of them.
upstream kapkan_challenge {
    server unix:{{.Node.ChallengeSocket}};
}

# The clearance page (edge-spec §5, E4): the proof-of-work rung's challenge
# page and answer endpoint, served by the node itself. A zone's requests reach
# it only when the decision service answers 401.
upstream kapkan_clearance {
    server unix:{{.Node.ClearanceSocket}};
    keepalive 16;
}

# What @kapkan_pass sends as the Connection header: empty for an ordinary
# request (upstream keepalive needs it cleared), "upgrade" when the client asked
# for one, so a WebSocket handshake reaches the origin intact.
map $http_upgrade $kapkan_connection {
    default upgrade;
    ""      "";
}

# A mark is believed only from a decision the service actually made — a 200
# (a 401 or 403 never reaches the origin, so it carries no mark). An answer
# outside the contract that happens to carry the header is a failed decision,
# and its mark must not reach the origin.
map $upstream_status $kapkan_decided_mark {
    default "";
    200     $upstream_http_x_kapkan_mark;
}

# The clearance cookie's value is the ONE client value the decision subrequest
# carries (E4). It is forwarded only when it is shaped like a clearance token:
# a control byte in it (nginx admits any but NUL in a cookie) would make the
# decision service refuse the whole subrequest as malformed — a failed
# decision, which failure_mode: open would pass. Anything else is forwarded as
# empty, and empty removes the header.
map $cookie_kapkan_clr $kapkan_clr_safe {
    default "";
    "~^[A-Za-z0-9._-]{1,512}$" $cookie_kapkan_clr;
}

{{- if .HasDecide}}

# The request's normalised path ($uri, captured in location / as
# $kapkan_path) is DECODED: "/x/%01" puts a raw control byte in it, which
# would make the decision service refuse the subrequest as malformed — the
# same failed decision as above, the same fail-open. Forwarded only when it
# is printable ASCII; anything else is forwarded as nothing, so the request is
# still decided and merely not exempt from the rung. (Only rendered when a
# zone decides: nothing else declares $kapkan_path.)
map $kapkan_path $kapkan_path_safe {
    default "";
    "~^/[\x21-\x7e]{0,2048}\z" $kapkan_path;
}
{{- end}}
{{- if .HashBucketSize}}

# A zone name longer than 46 bytes does not fit nginx's default server-name
# hash bucket (one CPU cache line) once a port carries two or more servers.
# Set once, here; the operator's nginx.conf must not set it as well.
server_names_hash_bucket_size {{.HashBucketSize}};
{{- end}}
{{- if not .Node.OmitCatchAll}}

# The catch-all: a Host or SNI that matches no zone is refused, instead of
# landing in whichever zone sorts first (zones are tenant data, edge-spec §4).
# 444 closes the connection without a response; ssl_reject_handshake answers
# an unknown or absent SNI with a TLS alert and needs no certificate.
server {
    listen 80 default_server;
{{- if not .Node.DisableIPv6}}
    listen [::]:80 default_server;
{{- end}}
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
{{- if not .Node.DisableIPv6}}
    listen [::]:443 ssl default_server;
{{- end}}
    server_name _;
    ssl_reject_handshake on;
    # nginx before 1.29.2 fixes the TLS protocol set from the DEFAULT server
    # before SNI selects a zone's server, so on those versions this line is the
    # node-wide floor: the lowest tls.min_version among the zones. From 1.29.2,
    # and on Angie, each zone's own ssl_protocols is honoured.
    ssl_protocols {{.NodeSSLProtocols}};
    return 444;
}
{{- end}}
