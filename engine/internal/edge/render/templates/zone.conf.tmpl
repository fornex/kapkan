# Zone {{.Name}} — generated by kapkan edge, DO NOT EDIT (see {{.CommonFile}}).
{{- if not .HasCert}}
#
# NO CERTIFICATE YET: only the plain-HTTP listener is rendered, and it serves
# nothing but ACME challenges — kapkan never proxies a zone over cleartext.
# The TLS server appears on the first render after issuance (edge-spec §3).
{{- end}}

upstream {{.OriginUpstream}} {
    # A hostname here is resolved once, when nginx loads the configuration; a
    # name that does not resolve fails `nginx -t` for the whole generation.
{{- range .Origins}}
    server {{.}};
{{- end}}
    keepalive 32;
}

server {
    listen 80;
{{- if not .Node.DisableIPv6}}
    listen [::]:80;
{{- end}}
    server_name {{.Name}};
    access_log syslog:server=unix:{{.Node.LogSocket}},nohostname,tag=kapkan kapkan_edge;

    # ACME HTTP-01 (edge-spec §3): a GET/HEAD of a token, nothing else, and no
    # body is ever carried into kapkan.
    location ^~ /.well-known/acme-challenge/ {
        limit_except GET HEAD { deny all; }
        proxy_pass http://kapkan_challenge;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Kapkan-Zone {{.Name}};
    }
{{- if .HasCert}}

    location / {
        return 301 https://$host$request_uri;
    }
{{- else}}

    location / {
        return 503;
    }
{{- end}}
}
{{- if .HasCert}}

server {
    listen 443 ssl http2;
{{- if not .Node.DisableIPv6}}
    listen [::]:443 ssl http2;
{{- end}}
    server_name {{.Name}};

    ssl_certificate     {{.Cert.Fullchain}};
    ssl_certificate_key {{.Cert.Key}};
    # Honoured per zone from nginx 1.29.2 and on Angie; older nginx applies the
    # catch-all's node-wide floor instead (see {{.CommonFile}}).
    ssl_protocols {{.SSLProtocols}};
{{- if .SSLCiphers}}
    ssl_ciphers {{.SSLCiphers}};
{{- end}}
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:kapkan_ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    access_log syslog:server=unix:{{.Node.LogSocket}},nohostname,tag=kapkan kapkan_edge;

    # try_files below stats a path under this root and never finds one: the
    # directory holds nothing. Every directory on the way to it must be
    # traversable by the terminator's worker user, or each request logs a
    # [crit] stat failure (while still passing).
    root {{.Node.EmptyRoot}};

    location ^~ /.well-known/acme-challenge/ {
        limit_except GET HEAD { deny all; }
        proxy_pass http://kapkan_challenge;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Kapkan-Zone {{.Name}};
    }
{{- if .Decide}}

    # The decision subrequest (edge-spec §5): headers only, never the body;
    # tight timeouts so a stalled decider cannot hold requests hostage.
    location = /_kapkan/decide {
        internal;
        proxy_pass http://kapkan_decide/decide;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Kapkan-Zone {{.Name}};
        proxy_set_header X-Kapkan-Client $remote_addr;
        proxy_set_header X-Kapkan-Method $request_method;
        proxy_set_header X-Kapkan-URI $request_uri;
        proxy_set_header X-Kapkan-User-Agent $http_user_agent;
        proxy_connect_timeout 50ms;
        proxy_send_timeout 100ms;
        proxy_read_timeout 200ms;
{{- if .FailOpen}}
        # failure_mode: open — a decider that is down, slow or off-contract is
        # absorbed HERE, inside the subrequest, as an undecided 200. The main
        # request never sees a 500 (which nginx would answer with
        # Connection: close), so its keepalive survives, and the origin gets
        # the request with no mark.
        proxy_intercept_errors on;
        error_page 500 502 503 504 =200 /_kapkan/undecided;
{{- end}}
    }
{{- if .FailOpen}}

    location = /_kapkan/undecided {
        internal;
        return 200;
    }
{{- end}}
{{- end}}

    # Every allowed request ends here, whether it came through the decision or
    # around a failed one. Named locations do not inherit a location's
    # error_page, so an origin failure below is reported as-is, not retried.
    location @kapkan_pass {
        proxy_pass http://{{.OriginUpstream}};
        proxy_http_version 1.1;
        # Cleared for ordinary requests so upstream keepalive works; "upgrade"
        # for an Upgrade request so a WebSocket tunnels (see {{.CommonFile}}).
        proxy_set_header Connection $kapkan_connection;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        # kapkan owns these two headers towards the origin: a client cannot
        # forge a zone or a mark, and an empty value removes the header.
        proxy_set_header X-Kapkan-Zone {{.Name}};
        proxy_set_header X-Kapkan-Mark {{if .Decide}}$kapkan_mark{{else}}""{{end}};
    }
{{- if and .Decide (not .FailOpen)}}

    location @kapkan_unavailable {
        return 503;
    }
{{- end}}

    location / {
{{- if .Decide}}
        auth_request /_kapkan/decide;
        auth_request_set $kapkan_mark $kapkan_decided_mark;
{{- if .FailOpen}}
        # Second net for failure_mode: open — anything the subrequest could
        # not absorb (an off-contract 3xx, say) still passes, undecided.
        error_page 500 502 503 504 = @kapkan_pass;
{{- else}}
        # failure_mode: closed — a failed decision is answered with 503.
        error_page 500 502 503 504 = @kapkan_unavailable;
{{- end}}
{{- end}}
        try_files /dev/null @kapkan_pass;
    }
{{- if .ExtraDirectivesFile}}

    # The one escape hatch (edge-spec §4): included verbatim, you own what it
    # breaks — `nginx -t` is the only guard.
    include {{.ExtraDirectivesFile}};
{{- end}}
}
{{- end}}
