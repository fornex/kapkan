[Unit]
Description=Kapkan DDoS detection and RTBH mitigation
Documentation=https://github.com/kapkan-io/kapkan
After=network-online.target
Wants=network-online.target
# Crash-loop guard: a binary that fails to start 4 times within 60s enters the
# "failed" state instead of restarting forever — so a bad upgrade is observable
# (deploy/update.sh health-checks /healthz and rolls back) rather than thrashing.
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
Type=simple
User=kapkan
Group=kapkan
ExecStart=/usr/local/bin/kapkan -config /etc/kapkan/config.yaml -log-format json -log-level info -pid-file /run/kapkan/kapkan.pid
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Runtime directory for the pid file (/run/kapkan, owned by the kapkan user,
# auto-created on start and removed on stop). The daemon writes its pid here so
# operators can run `kapkan -s reload` / `kapkan -s stop` — the nginx-style
# local control path — without looking up the pid. `systemctl reload kapkan`
# (ExecReload above) and `kapkan -s reload` both deliver SIGHUP.
RuntimeDirectory=kapkan
RuntimeDirectoryMode=0755

# The Telegram bot token is read from the environment, never the config file.
# Put it in /etc/kapkan/kapkan.env as KAPKAN_TG_TOKEN=... (chmod 600).
EnvironmentFile=-/etc/kapkan/kapkan.env

# Writable state directory (/var/lib/kapkan, owned by the kapkan user). Used by
# ban.state_file to persist active bans so a restart rehydrates and re-announces
# them instead of dropping mitigation. systemd adds it to ReadWritePaths, so it
# stays writable under ProtectSystem=strict below.
StateDirectory=kapkan
StateDirectoryMode=0700

# Hardening. kapkan needs no special privileges in dry-run or when peering
# from a high local port; if you bind BGP to port 179, add the capability:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#
# THE XDP DATA PLANE NEEDS MORE THAN THIS UNIT GRANTS, and deliberately so.
# `dataplane.enabled: true` requires CAP_BPF/CAP_NET_ADMIN/CAP_PERFMON, a
# writable /sys/fs/bpf (which ProtectKernelTunables below mounts read-only) and
# AF_NETLINK (which RestrictAddressFamilies below omits). Rather than grant all
# of that to every deployment — most mitigate through BGP alone and touch no
# BPF — the relaxations ship as an opt-in drop-in next to this file:
#
#   install -D -m 0644 kapkan-dataplane.conf \
#       /etc/systemd/system/kapkan.service.d/10-dataplane.conf
#
# Install it on the same hosts where you turn dataplane.enabled on. Without it
# those hosts FAIL AT STARTUP with a message naming the cause, which is the
# intended behaviour: an operator who configured in-kernel drops must not get a
# daemon that silently came up without them. See kapkan-dataplane.conf and
# dataplane-operations.md §1 for what each line does and what it costs.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/kapkan
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
